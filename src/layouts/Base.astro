---
import "../styles/global.css";
import { absolute, jsonLd, pageGraph, type Crumb, type Question } from "../lib/seo";
import { lastModified } from "../lib/lastmod";
import { homeCard, ogImagePath } from "../lib/og";
import { localeTag, ogLocale, type Locale } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** The locale of this page. Defaults to English (the base, unprefixed URLs). */
  locale?: Locale;
  /** The share image, a site path (src/lib/og.ts). Defaults to the home page's. */
  image?: string;
  /** What the share image says, for screen readers. Localized headline on localized pages. */
  imageAlt?: string;
  breadcrumb?: Crumb[];
  faq?: Question[];
  /** hreflang alternates (one per locale + x-default). Omit to emit none. */
  hreflang?: { hreflang: string; url: string }[];
}

const {
  title,
  description,
  noindex = false,
  locale = "en",
  image = ogImagePath(homeCard.slug),
  imageAlt = homeCard.lines.join(" "),
  breadcrumb,
  faq,
  hreflang,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = absolute(path);
const ogImage = absolute(image);
const modified = noindex ? undefined : lastModified(path);
const graph = noindex
  ? undefined
  : pageGraph({ path, title, description, image, breadcrumb, faq, modified, inLanguage: localeTag[locale] });
---

<!doctype html>
<html lang={localeTag[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0B0C0E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F7F9" media="(prefers-color-scheme: light)" />
    <!-- Applies a stored Light/Dark choice before first paint (src/lib/theme.ts). -->
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
          <link rel="canonical" href={canonical} />
        </>
      )
    }

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- A plain-text summary of the site for AI assistants (llmstxt.org), src/pages/llms.txt.ts. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="After Stories for AI assistants" />
    <!-- Where to start: /ai.txt points crawlers at llms.txt and llms-full.txt (src/pages/ai.txt.ts). -->
    <link rel="alternate" type="text/plain" href="/ai.txt" title="AI crawler notes for After Stories" />

    {
      hreflang &&
        hreflang.map((a) => (
          <link rel="alternate" hreflang={a.hreflang} href={a.url} />
        ))
    }

    <!-- Anybody is served from this site, not Google Fonts, so no visitor's IP goes to Google. -->
    <link rel="preload" href="/fonts/anybody-latin.woff2" as="font" type="font" crossorigin />

    <meta name="application-name" content="After Stories" />
    <meta name="apple-mobile-web-app-title" content="After Stories" />
    <meta name="author" content="12f ApS" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="After Stories" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {modified && <meta property="og:updated_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {graph && <script type="application/ld+json" set:html={jsonLd(graph)} />}

    <script is:inline defer src="https://umami.robert-jensen.dk/script.js" data-website-id="d3cff791-e5e1-4dde-a312-8714ddd1fa3d" data-performance="true"></script>

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
