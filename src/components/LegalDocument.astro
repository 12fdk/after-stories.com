---
// A legal page's text (the privacy policy, the terms): Danish then English, as HTML from
// src/data/. The text is ours and static, so set:html is safe; the styles reach into it with
// :global because Astro doesn't scope injected HTML.
interface Props {
  html: string;
}

const { html } = Astro.props;
---

<main class="wrap legal" set:html={html} />

<style>
  .legal {
    max-width: 720px;
    padding-top: 48px;
    padding-bottom: 96px;
  }

  .legal :global(.lang),
  .legal :global(.meta) {
    color: var(--text-secondary);
  }

  .legal :global(article) {
    margin-top: 32px;
  }

  .legal :global(article + article) {
    margin-top: 72px;
  }

  /* Between the Danish and the English text: a small sun instead of a rule. */
  .legal :global(hr) {
    width: 48px;
    height: 24px;
    margin: 72px 0 0;
    border: 0;
    border-radius: 999px 999px 0 0;
    background: var(--accent);
  }

  .legal :global(h1) {
    font-size: var(--t-head);
  }

  .legal :global(.meta) {
    margin-top: 16px;
  }

  .legal :global(h2) {
    font-size: var(--t-lead);
    margin-top: 48px;
    margin-bottom: 12px;
  }

  .legal :global(h3) {
    font-size: var(--t-body);
    margin-top: 28px;
    margin-bottom: 8px;
  }

  .legal :global(p + p),
  .legal :global(ul + p),
  .legal :global(p + ul) {
    margin-top: 12px;
  }

  .legal :global(ul) {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }

  .legal :global(p),
  .legal :global(li) {
    max-width: 64ch;
  }

  .legal :global(a) {
    color: var(--accent-ink);
  }
</style>
