---
import { events, eventHref } from "../data/events";
import ThemeSwitch from "./ThemeSwitch.astro";
---

<footer class="footer">
  <div class="wrap footer-inner">
    <p class="footer-tagline">Plan it together. Live it together. Wake up to the story.</p>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/">Home</a>
      {events.map((e) => <a href={eventHref(e)}>{e.name}</a>)}
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
    <ThemeSwitch />
    <p>© {new Date().getFullYear()} <a href="https://12f.dk">12f ApS</a></p>
  </div>
</footer>
