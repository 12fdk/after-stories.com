---
// Then it's gone: three facts of the app as three tiles that step down, like a sun going down.
// The 48 hours always come with saving the photos (docs/messaging.md rule 8): that's the text.
interface Props {
  title: string;
  text: string;
  morning: string;
  people: string;
}

const { title, text, morning, people } = Astro.props;
---

<section class="section wrap figures">
  <div class="tile tile-sun" data-reveal>
    <p class="figure" aria-hidden="true">48h</p>
    <p class="tile-text">{text}</p>
  </div>
  <h2 class="figures-title">{title}</h2>
  <div class="tile tile-ink" data-reveal>
    <p class="figure">06:00</p>
    <p class="tile-text">{morning}</p>
  </div>
  <div class="tile tile-mid" data-reveal>
    <p class="figure">50</p>
    <p class="tile-text">{people}</p>
  </div>
</section>

<style>
  .figures {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 28px;
    border-radius: var(--radius);
  }

  .figure {
    font-family: var(--display);
    font-stretch: 100%;
    font-weight: 900;
    font-size: var(--t-display);
    line-height: 0.85;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .tile-text {
    max-width: 34ch;
  }

  /* The sun: a half-disc on top, the figure and its words at its foot. */
  .tile-sun {
    grid-column: 1 / -1;
    justify-content: flex-end;
    min-height: 110vw;
    border-radius: 999px 999px var(--radius) var(--radius);
    background: var(--accent);
    color: var(--on-accent);
  }

  .tile-sun .tile-text {
    font-size: var(--t-lead);
    line-height: 1.4;
  }

  .tile-ink {
    background: var(--text-primary);
    color: var(--background);
  }

  .tile-mid {
    margin-top: 32px;
    background: var(--surface-elevated);
  }

  .figures-title {
    grid-column: 1 / -1;
    grid-row: 1;
    margin-bottom: 24px;
  }

  .tile-ink .figure,
  .tile-mid .figure {
    font-size: var(--t-head);
  }

  @media (min-width: 900px) {
    .figures {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto auto;
      align-items: start;
    }

    .tile {
      padding: 36px;
    }

    .tile-sun {
      grid-column: 1 / 7;
      grid-row: 1 / 4;
      min-height: max(70vh, 640px);
    }

    .figures-title {
      grid-column: 7 / 13;
      grid-row: 1;
      align-self: end;
      margin: 0 0 24px 32px;
    }

    .tile-ink {
      grid-column: 7 / 10;
      grid-row: 2;
      min-height: 44vh;
    }

    .tile-mid {
      grid-column: 10 / 13;
      grid-row: 2;
      margin-top: 12vh;
      min-height: 34vh;
    }
  }
</style>
