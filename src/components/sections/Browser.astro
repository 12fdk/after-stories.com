---
import Icon from "../Icon.astro";
import WebAppCta from "../WebAppCta.astro";
import type { Locale } from "../../lib/i18n";

// No iPhone? The browser (app.after-stories.com): on a computer or Android, someone can start the
// event there too (app repo #757/#761), and their group joins from the invite link on any phone.
// StoryBrand: it takes away the last objection to the plan ("not everyone has an iPhone"), so it
// sits right after it, and its call to action is the web app's button (docs/messaging.md, rule 5).
// The picture is the real web app in a browser window, in the visitor's language: a live event's
// chat and its details (public/app/<locale>/live-browser.webp). It is shot from the production build
// with the App Store screenshots' demo story (app repo, web/screenshots/README.md).
interface Props {
  copy: { title: string; text: string; points: string[]; note: string; alt: string };
  locale?: Locale;
}

const { copy, locale = "en" } = Astro.props;
---

<section id="browser" class="section wrap browser">
  <div class="browser-copy" data-reveal>
    <h2>{copy.title}</h2>
    <p class="lead">{copy.text}</p>
    <ul class="points">
      {
        copy.points.map((p) => (
          <li>
            <Icon name="Check" class="point-icon" />
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
    <p class="note">{copy.note}</p>
    <WebAppCta placement="browser" locale={locale} />
  </div>

  <div class="window" data-reveal>
    <div class="window-bar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="address">app.after-stories.com</span>
    </div>
    <img
      class="window-screen"
      src={`/app/${locale}/live-browser.webp`}
      alt={copy.alt}
      width="1600"
      height="1109"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style>
  .browser {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .browser-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .browser-copy .lead {
    max-width: 40ch;
  }

  .points {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .points :global(.point-icon) {
    width: 22px;
    height: 22px;
    margin-top: 1px;
    color: var(--accent-ink);
  }

  .note {
    max-width: 44ch;
    font-size: var(--t-small);
    color: var(--text-secondary);
  }

  /* A browser window, drawn in CSS: the bar with its three dots and the address, then the app's
     screenshot (dark, as the app is in both themes). */
  .window {
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: #1f2328;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.45);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
  }

  .dots {
    display: flex;
    gap: 7px;
  }

  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #45494f;
  }

  .address {
    flex: 1;
    max-width: 320px;
    margin-inline: auto;
    padding: 5px 12px;
    border-radius: 7px;
    background: #0b0c0e;
    color: #a2aab3;
    font-size: var(--t-small);
    text-align: center;
  }

  .window-screen {
    display: block;
    width: 100%;
    height: auto;
    background: #0b0c0e;
  }

  @media (min-width: 900px) {
    .browser {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 72px;
    }
  }
</style>
