---
import LaunchCta from "../LaunchCta.astro";
import type { Locale } from "../../lib/i18n";

// The close: one row of three tiles. The middle one is the sun's pink and holds the success, the
// failure and the form; one flank is a photo of the event, the other the dawn coming up over a
// city (CC0 footage, credited in the footer). The row runs off both edges of the screen.
interface Props {
  title: string;
  success: string;
  stakes: string;
  photo: { src: string; alt: string; width: number; height: number };
  locale?: Locale;
}

const { title, success, stakes, photo, locale = "en" } = Astro.props;
---

<section class="section closer">
  <div class="closer-row">
    <div class="flank flank-photo">
      <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
    </div>

    <div class="closer-tile" data-reveal>
      <h2>{title}</h2>
      <p class="closer-success">{success}</p>
      <p class="closer-stakes">{stakes}</p>
      <LaunchCta as="form" locale={locale} />
    </div>

    <div class="flank flank-dawn">
      <video autoplay muted loop playsinline preload="metadata" poster="/media/morgenstimmung-am-drachenberg-01-poster.jpg" width="854" height="480" aria-hidden="true">
        <source src="/media/morgenstimmung-am-drachenberg-01.webm" type="video/webm" />
      </video>
    </div>
  </div>
</section>

<script>
  // A silent loop is decoration: with reduced motion it stays on its poster frame.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLVideoElement>(".flank-dawn video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
    });
  }
</script>

<style>
  .closer {
    overflow: hidden;
  }

  .closer-row {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .closer-tile {
    grid-column: 1 / -1;
    grid-row: 1;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 20px;
    padding: 48px 20px;
    border-radius: var(--radius);
    background: var(--accent);

    /* The page's tokens, turned for the pink: dark ink, a dark button, white fields. */
    --text-primary: #0b0c0e;
    --text-secondary: #2a0f1c;
    --text-tertiary: #2a0f1c;
    --surface: #ffffff;
    --accent-ink: #0b0c0e;
    --accent-pressed: #2a0f1c;
    --accent-disabled: #45202d;
    --failure: #4a0016;
    color: var(--text-primary);
  }

  .closer-tile :global(.pill) {
    background: #0b0c0e;
    color: #ffffff;
  }

  .closer-tile :global(.pill:hover) {
    background: #2a0f1c;
  }

  .closer-tile :global(:focus-visible) {
    outline-color: #0b0c0e;
  }

  .closer-tile h2 {
    max-width: none;
  }

  .closer-success {
    font-size: var(--t-lead);
    line-height: 1.4;
    max-width: 44ch;
  }

  .closer-stakes {
    max-width: 52ch;
  }

  .flank {
    height: 160px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .flank img,
  .flank video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .closer-row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 8fr) minmax(0, 2fr);
      gap: 12px;
      margin: 0 calc(var(--radius) * -1);
    }

    .closer-tile {
      grid-column: 2;
      padding: 72px 64px;
      min-height: 560px;
    }

    .flank {
      height: auto;
    }
  }
</style>
