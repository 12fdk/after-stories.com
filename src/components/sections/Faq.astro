---
// Good to know: the heading stays put while the questions pass. Each question is a filled tile;
// the open one turns the sun's pink. One open at a time (a shared name on <details>).
interface Props {
  title: string;
  faq: { q: string; a: string }[];
}

const { title, faq } = Astro.props;
---

<section id="faq" class="section wrap faq">
  <h2 class="faq-title">{title}</h2>
  <div class="faq-list" data-reveal>
    {
      faq.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="plus" aria-hidden="true" />
          </summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .faq {
      grid-template-columns: 4fr 8fr;
      gap: 32px;
    }
    .faq-title {
      position: sticky;
      top: 96px;
    }
  }

  .faq-list {
    display: grid;
    gap: 8px;
  }

  details {
    border-radius: 22px;
    background: var(--surface);
  }

  @media (prefers-reduced-motion: no-preference) {
    details {
      transition: background-color 0.25s ease;
    }
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    min-height: 72px;
    padding: 18px 24px;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    font-size: var(--t-lead);
    line-height: 1.3;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover .plus {
    transform: rotate(90deg);
  }

  /* A plus from two 3px bars; the upright one turns flat when the answer is open. */
  .plus {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }

  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    left: 0;
    top: 6.5px;
    width: 16px;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
  }

  .plus::after {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .plus,
    .plus::after {
      transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  details[open] {
    background: var(--accent);
    color: var(--on-accent);
  }

  details[open] .plus::after {
    transform: rotate(0deg);
  }

  details p {
    padding: 0 24px 24px;
    max-width: 60ch;
  }
</style>
