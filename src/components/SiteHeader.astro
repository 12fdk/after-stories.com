---
import AppStoreCta from "./AppStoreCta.astro";
import Icon from "./Icon.astro";
import { uiCopy, localizedPath, type Locale } from "../lib/i18n";

// StoryBrand: the direct call to action in the header, next to the transitional "How it works".
// The home page and the event pages have the same four sections (how, occasions, privacy, faq),
// so their links jump on the page. Pages without them (privacy, terms) jump to the home page's.
// The call to action is the pair from AppStoreCta: Apple's badge, then the web app's button, last in
// the header and on every width (docs/messaging.md, rule 5).
// Where the text links don't fit, a menu button before the badge holds all of them. It is a native
// <details>, so it opens without JavaScript; the script only closes it the way a menu should close.
interface Props {
  /** The page's locale; defaults to English (the base, unprefixed pages). */
  locale?: Locale;
  /** True when this page has the four sections the links point at. */
  onPage?: boolean;
}

const { locale = "en", onPage = false } = Astro.props;
const ui = uiCopy(locale);
const homeHref = localizedPath(locale, "/");
const at = onPage ? "" : homeHref;
const links = [
  { href: `${at}#how`, label: ui.navHowItWorks, keep: true },
  { href: `${at}#occasions`, label: ui.navOccasions },
  { href: `${at}#privacy`, label: ui.navPrivacy },
  { href: `${at}#faq`, label: ui.navFaq },
  { href: "/blog/", label: "Blog" },
];
---

<header class="topbar wrap">
  <!-- The icon is the logo, so it needs the brand name. The wordmark is hidden from
       assistive tech so the link is announced once: "After Stories home". -->
  <a class="brand" href={homeHref} aria-label="After Stories home">
    <img src="/apple-touch-icon.png" alt="After Stories" width="36" height="36" />
    <span aria-hidden="true">After Stories</span>
  </a>
  <nav class="topbar-nav" aria-label="Main">
    <details class="menu">
      <summary class="menu-button">
        <Icon name="Menu" class="menu-icon" />
        <span class="visually-hidden">{ui.navMenu}</span>
      </summary>
      <div class="menu-panel">
        {links.map((l) => <a class="menu-link" href={l.href}>{l.label}</a>)}
      </div>
    </details>
    {links.map((l) => <a class:list={["topbar-link", { keep: l.keep }]} href={l.href}>{l.label}</a>)}
    <AppStoreCta placement="header" size="small" locale={locale} />
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>("details.menu").forEach((menu) => {
    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) menu.open = false;
    });
    document.addEventListener("click", (event) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });
  });
</script>

<style>
  .topbar {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--display);
    font-stretch: 90%;
    font-weight: 800;
    font-size: var(--t-lead);
    white-space: nowrap;
  }

  .brand img {
    border-radius: 9px;
  }

  .topbar-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  /* Apple's badge never shrinks below its 40 px size, and the button keeps its size beside it. */
  .topbar-nav > :global(*) {
    flex: none;
  }

  .topbar-link {
    color: var(--text-primary);
    text-decoration: none;
    font-size: var(--t-small);
    font-weight: 600;
    padding: 12px 0;
    text-decoration: underline 2px transparent;
    text-underline-offset: 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .topbar-link {
      transition: text-decoration-color 0.2s ease;
    }
  }

  .topbar-link:hover {
    text-decoration-color: var(--accent);
  }

  /* The menu is for the widths that hide links. It hangs from the header, gutter to gutter on a phone. */
  .menu {
    display: none;
  }

  .menu-button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hairline);
    border-radius: 9px;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }

  .menu-button::-webkit-details-marker {
    display: none;
  }

  .menu-button :global(.menu-icon) {
    width: 22px;
    height: 22px;
  }

  .menu[open] .menu-button {
    border-color: var(--accent-ink);
  }

  .menu-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .menu-panel {
    position: absolute;
    top: calc(100% - 12px);
    right: var(--gutter);
    left: var(--gutter);
    display: grid;
    padding: 8px;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    background: var(--surface-elevated);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.25);
  }

  .menu-link {
    padding: 13px 12px;
    border-radius: 8px;
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .menu-link:hover {
    background: var(--surface);
  }

  /* Wide screens show every link; a laptop and a tablet keep "How it works" and the menu; below that the header is the logo, the menu, the badge and "Open app". */
  @media (max-width: 1140px) {
    .topbar-link:not(.keep) {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  @media (min-width: 601px) and (max-width: 1140px) {
    .menu-panel {
      left: auto;
      width: 280px;
    }
  }

  @media (max-width: 800px) {
    .topbar-nav {
      gap: 16px;
    }
    .topbar-link {
      display: none;
    }
  }

  /* Phones: the icon alone carries the brand (the web app's button shrinks in WebAppCta). */
  @media (max-width: 600px) {
    .topbar {
      gap: 8px;
    }
    .topbar-nav {
      gap: 8px;
    }
    .brand span {
      display: none;
    }
  }

  /* The narrowest phones have no room for the logo; the footer still links home. */
  @media (max-width: 359px) {
    .brand {
      display: none;
    }
    .topbar-nav {
      margin-left: auto;
    }
  }
</style>
