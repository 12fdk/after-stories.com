---
import { splitHearts } from "../lib/rich";

// Copy text with the app's like (❤️) drawn as the site's own heart instead of an emoji.
// The copy keeps the emoji (llms.txt reads it as is); only the page swaps it.
interface Props {
  text: string;
}

const { text } = Astro.props;
const parts = splitHearts(text);
---

{
  parts.map((part, i) => (
    <>
      {part}
      {i < parts.length - 1 && (
        <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="❤️">
          <path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.3 3 4.5 6.7 4.5c2.1 0 3.5 1.1 5.3 3.1 1.8-2 3.2-3.1 5.3-3.1 3.7 0 5.8 3.8 4.3 7.2C19.5 16.4 12 21 12 21z" />
        </svg>
      )}
    </>
  ))
}
