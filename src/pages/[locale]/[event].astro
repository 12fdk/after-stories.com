---
import EventPage from "../../components/EventPage.astro";
import { locales, localEvents, type Locale } from "../../lib/i18n";

// One localized page per event type (non-English locales), filled from the localized copy
// (src/data/copy/<locale>.ts) over the structural event data: src/components/EventPage.astro.
export function getStaticPaths() {
  return locales
    .filter((l) => l !== "en")
    .flatMap((locale) => localEvents(locale).map((e) => ({ params: { locale, event: e.slug }, props: { locale, slug: e.slug } })));
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
---

<EventPage locale={locale} slug={slug} />
