---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import LaunchCta from "../../components/LaunchCta.astro";
import Icon from "../../components/Icon.astro";
import {
  locales,
  localeTag,
  localEvents,
  localEventHref,
  basePath,
  eventCopy,
  uiCopy,
  hreflangAlternates,
  localizedPath,
  type Locale,
} from "../../lib/i18n";
import { SITE_URL } from "../../lib/seo";
import { ogImagePath } from "../../lib/og";

// One localized page per event type (non-English locales), filled from the localized copy
// (src/data/copy/<locale>.ts) over the structural event data. Mirrors src/pages/[event].astro.
export function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    if (locale === "en") continue;
    for (const event of localEvents(locale)) {
      paths.push({ params: { locale: locale, event: event.slug }, props: { locale, event } });
    }
  }
  return paths;
}

const { locale, event } = Astro.props as { locale: Locale; event: (typeof localEvents)[number][number] };
const { mock, hero } = event;
const ui = uiCopy(locale);
const scrimLight = hero.scrim?.light ?? 0.9;
const scrimDark = hero.scrim?.dark ?? 0.82;
const totalVotes = mock.options.reduce((sum, o) => sum + o.votes, 0);
const options = mock.options.map((o, i) => ({
  ...o,
  share: Math.round((o.votes / totalVotes) * 100),
  leading: i === 0,
}));
const privacy = event.privacy;
const others = localEvents(locale).filter((e) => e.slug !== event.slug);
const base = `/${event.slug}/`;
const breadcrumb = [
  { name: "After Stories", path: localizedPath(locale, "/") },
  { name: event.name, path: localEventHref(locale, event.slug) },
];
---

<Base
  locale={locale}
  title={event.title}
  description={event.description}
  image={ogImagePath(event.slug)}
  imageAlt={event.headline.join(" ")}
  breadcrumb={breadcrumb}
  faq={event.faq}
  hreflang={hreflangAlternates(SITE_URL, base, true)}
>
  <SiteHeader locale={locale} />
  <main>
    <section class="hero site-hero">
      <img class="hero-photo" src={hero.src} alt={hero.alt} width="1344" height="756" fetchpriority="high" decoding="async" />
      <div class="hero-scrim" style={`--scrim-light:${scrimLight};--scrim-dark:${scrimDark}`} aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1>
            {
              event.headline.map((line) => (
                <span class="line">
                  {line.split(/(\S+-\S+)/).map((part) => (part.includes("-") ? <span class="nowrap">{part}</span> : part))}
                </span>
              ))
            }
          </h1>
          <p class="lede">{event.lede}</p>
          <div class="cta">
            <LaunchCta as="link" locale={locale} />
            <p class="fineprint">{event.fineprint}</p>
          </div>
        </div>

        <figure class="event" aria-label={`Example of a ${event.name.toLowerCase()} event while it's being planned`}>
          <div>
            <p class="event-stage"><span>{ui.planning}</span><span>{mock.people} {ui.peopleWord}</span></p>
            <p class="event-title">{mock.title}</p>
          </div>

          <p class="next-step">{ui.votePrefix}: {mock.question}</p>

          <div class="poll">
            <p class="poll-q">{mock.question}</p>
            <ul class="poll-options">
              {
                options.map((o) => (
                  <li class={o.leading ? "is-leading" : undefined} style={`--share:${o.share}%`}>
                    <span>{o.label}</span>
                    <span class="votes">{o.votes}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p class="mini-label">{ui.decided}</p>
            <ol class="decided">
              {mock.decided.map((d) => <li><span class="tick" aria-hidden="true">✓</span>{d}</li>)}
            </ol>
          </div>
        </figure>
      </div>
    </section>

    <section class="section wrap">
      <h2 class="section-title">{event.todayTitle}</h2>
      <p class="section-intro">{event.problem}</p>
      <div class="today-grid">
        <ul class="today-list" aria-label="How it's planned today">
          {
            event.today.map((t) => (
              <li>
                <Icon class="today-icon" name={t.icon} />
                <s>{t.text}</s>
              </li>
            ))
          }
        </ul>
        <div class="today-after">
          <p class="today-with">{ui.withApp}</p>
          <p class="today-one">{event.todayOne}</p>
          <p>{event.todayText}</p>
        </div>
      </div>
    </section>

    <section class="section wrap">
      <h2 class="section-title">{event.howTitle}</h2>
      <p class="section-intro">{event.empathy}</p>
      <ol class="steps">
        {
          event.beats.map((b) => (
            <li class="step">
              <p class="step-when">{b.when}</p>
              <h3>{b.name}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="section-cta">
        <LaunchCta as="link" locale={locale} />
      </div>
    </section>

    <section class="section wrap">
      <h2 class="section-title">{event.occasionsTitle}</h2>
      <ul class="tiles">
        {
          event.occasions.map((o) => (
            <li>
              <span class="tile">
                <Icon class="tile-icon" name={o.icon} />
                {o.name}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section wrap">
      <h2 class="section-title">{event.privacyTitle}</h2>
      <ul class="facts">
        {privacy.map((f) => <li><strong>{f.title}</strong> {f.text}</li>)}
      </ul>
    </section>

    <section class="section wrap">
      <h2 class="section-title">{ui.goodToKnow}</h2>
      <div class="faq-list">
        {
          event.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="section wrap">
      <h2 class="section-title">{ui.planningSomethingElse}</h2>
      <ul class="tiles">
        {
          others.map((o) => (
            <li>
              <a class="tile tile-link" href={localEventHref(locale, o.slug)}>
                <Icon class="tile-icon" name={o.icon} />
                <span>{o.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="closer">
      <div class="wrap closer-inner">
        <h2>{event.closer}</h2>
        <div class="closer-story">
          <p>{event.success}</p>
          <p class="closer-stakes">{event.stakes}</p>
        </div>
        <LaunchCta as="form" locale={locale} />
      </div>
    </section>
  </main>
  <SiteFooter locale={locale} base={base} />
</Base>

<style>
  h1 {
    font-size: clamp(2.75rem, 6.6vw, 4.75rem);
  }

  .nowrap {
    white-space: nowrap;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(246, 247, 249, var(--scrim-light, 0.9)) 0%, rgba(246, 247, 249, calc(var(--scrim-light, 0.9) * 0.7)) 55%, rgba(246, 247, 249, 0) 100%);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hero-scrim {
      background: linear-gradient(180deg, rgba(11, 12, 14, var(--scrim-dark, 0.82)) 0%, rgba(11, 12, 14, calc(var(--scrim-dark, 0.82) * 0.62)) 55%, rgba(11, 12, 14, 0) 100%);
    }
  }

  :root[data-theme="dark"] .hero-scrim {
    background: linear-gradient(180deg, rgba(11, 12, 14, var(--scrim-dark, 0.82)) 0%, rgba(11, 12, 14, calc(var(--scrim-dark, 0.82) * 0.62)) 55%, rgba(11, 12, 14, 0) 100%);
  }

  .site-hero {
    position: relative;
    padding-top: 0;
    padding-bottom: 64px;
  }

  @media (min-width: 900px) {
    .site-hero {
      padding-bottom: 88px;
    }
  }

  .site-hero > .wrap {
    position: relative;
    z-index: 2;
  }

  .site-hero :global(header.topbar) {
    position: relative;
    z-index: 2;
  }

  .event {
    position: relative;
    z-index: 2;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 28px;
    padding: 24px;
    display: grid;
    gap: 16px;
    box-shadow: 0 30px 80px -30px rgba(255, 45, 111, 0.35);
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }

  .event-stage {
    display: flex;
    gap: 12px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .event-stage span:first-child {
    color: var(--accent-ink);
  }

  .event-title {
    font-family: var(--display);
    font-stretch: 85%;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .next-step {
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 14px;
    padding: 12px 16px;
    font-weight: 700;
  }

  .poll {
    background: var(--surface-elevated);
    border-radius: 16px;
    padding: 16px;
    display: grid;
    gap: 10px;
  }

  .poll-q {
    font-weight: 700;
  }

  .poll-options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .poll-options li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 0.9375rem;
    background: linear-gradient(90deg, var(--hairline) var(--share), var(--background) var(--share));
  }

  .poll-options li.is-leading {
    background: linear-gradient(90deg, var(--accent-disabled) var(--share), var(--background) var(--share));
    font-weight: 700;
  }

  .votes {
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }

  .mini-label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .decided {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 0.9375rem;
  }

  .tick {
    color: var(--accent-ink);
    font-weight: 800;
    margin-right: 10px;
  }

  .today-grid {
    display: grid;
    gap: 16px 48px;
    margin-top: 40px;
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .today-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .today-list li {
    display: flex;
    gap: 14px;
    align-items: center;
    border-top: 1px solid var(--hairline);
    padding: 16px 0;
    color: var(--text-secondary);
  }

  .today-list :global(.today-icon) {
    width: 22px;
    height: 22px;
    color: var(--text-tertiary);
  }

  .today-list s {
    text-decoration-color: var(--text-tertiary);
  }

  .today-after {
    display: grid;
    gap: 8px;
    align-content: center;
  }

  .today-with {
    color: var(--accent-ink);
    font-weight: 700;
    font-size: var(--step--1);
  }

  .today-one {
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .today-after p:last-child {
    color: var(--text-secondary);
    font-size: 1.125rem;
    max-width: 36ch;
  }
</style>
