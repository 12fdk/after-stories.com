---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LegalDocument from "../components/LegalDocument.astro";
import { PRIVACY_HTML } from "../data/privacy";
import { legalPages } from "../data/legal";

// The one privacy policy for the app AFTER and this website (12fdk/after-stories#337). The text
// and when to change it: src/data/privacy.ts. after.12f.dk/privacy 301s here, and App Store
// Connect's Privacy Policy URL points here.
const { title, description } = legalPages.privacy;
---

<Base
  title={title}
  breadcrumb={[
    { name: "After Stories", path: "/" },
    { name: "Privacy policy", path: "/privacy/" },
  ]}
  description={description}
>
  <SiteHeader />
  <LegalDocument html={PRIVACY_HTML} />
  <SiteFooter />
</Base>
