---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<Base title="Page not found — After Stories" description="This page went home early." noindex>
  <SiteHeader />
  <main class="wrap lost">
    <h1>This page went home early.</h1>
    <p class="lead">Whatever was here isn't anymore. The rest of the night is still on.</p>
    <a class="pill" href="/">Back to After Stories</a>
    <div class="sun" aria-hidden="true"></div>
  </main>
</Base>

<style>
  .lost {
    position: relative;
    min-height: calc(100svh - 92px);
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 28px;
    padding-top: 12vh;
    overflow: hidden;
  }

  h1 {
    max-width: 10ch;
  }

  /* The sun, half set: the night's over for this page. */
  .sun {
    position: absolute;
    right: -10vw;
    bottom: 0;
    width: min(70vw, 760px);
    aspect-ratio: 2 / 1;
    border-radius: 999px 999px 0 0;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sun {
      animation: set 1.6s cubic-bezier(0.16, 0.8, 0.2, 1) both;
    }
  }

  @keyframes set {
    from {
      transform: translateY(-30%);
    }
  }
</style>
