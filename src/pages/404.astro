---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — After Stories" description="This page went home early." noindex>
  <main class="wrap lost">
    <p class="code">404</p>
    <h1>This page went home early.</h1>
    <p>Whatever was here isn't anymore.</p>
    <a class="pill" href="/">Back to After Stories</a>
  </main>
</Base>

<style>
  .lost {
    min-height: 100vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 20px;
  }

  .code {
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 8rem);
    line-height: 0.85;
    color: var(--accent-ink);
  }

  h1 {
    font-size: var(--step-3);
  }

  p:not(.code) {
    color: var(--text-secondary);
  }
</style>
