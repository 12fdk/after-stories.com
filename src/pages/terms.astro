---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LegalDocument from "../components/LegalDocument.astro";
import { TERMS_HTML } from "../data/terms";
import { legalPages } from "../data/legal";

// The app's terms of use (12fdk/after-stories#337), the page the app links and asks everyone to
// accept. The text and when to bump its version: src/data/terms.ts. after.12f.dk/terms 301s here.
const { title, description } = legalPages.terms;
---

<Base
  title={title}
  breadcrumb={[
    { name: "After Stories", path: "/" },
    { name: "Terms of use", path: "/terms/" },
  ]}
  description={description}
>
  <SiteHeader notifyHref="/#notify" />
  <LegalDocument html={TERMS_HTML} />
  <SiteFooter />
</Base>
