---
import EventPage from "../components/EventPage.astro";
import { events } from "../data/events";

// One page per event type (src/data/events.ts). The page itself: src/components/EventPage.astro,
// shared with the other locales.
export function getStaticPaths() {
  return events.map((event) => ({ params: { event: event.slug }, props: { slug: event.slug } }));
}

const { slug } = Astro.props as { slug: string };
---

<EventPage locale="en" slug={slug} />
