---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { events, eventHref } from "../data/events";

// Copy and structure: docs/positioning.md › The landing page.
const title = "After Stories — Plan it together. Live it together. Wake up to the story.";
const description =
  "A private app for one trip, party or night out. Vote on the plan, share photos in one stream, and wake up to the morning-after story. Everything disappears 48 hours after.";

// Hero: the morning-after summary of a weekend away (the hero use case).
const decided = [
  { when: "Fri", what: "Lake house, Hallstatt" },
  { when: "Sat 13:00", what: "Hike to the waterfall" },
  { when: "Sat 20:00", what: "Fondue at Maya's place" },
];

// The three beats (the eight steps, compressed for a first-time visitor).
const beats = [
  {
    key: "plan",
    when: "Before",
    name: "Plan it together",
    text: "Ask the group. Which weekend, which house, who drives. Every vote turns into a decision, and the decisions stay on top as a timeline. Nobody scrolls back to find them.",
  },
  {
    key: "live",
    when: "During",
    name: "Live it together",
    text: "One stream for the whole event: “10 minutes late”, the photos, where to go next. Tap ❤️ on the ones that matter.",
  },
  {
    key: "after",
    when: "The morning after",
    name: "Wake up to the story",
    text: "Everyone gets the summary: the most-liked photo, the line of the night, what you decided. Then save every photo to your phone with one tap.",
  },
];

// The pain: two group chats that went nowhere. Avatars use the app's tile ramp, like its fallback.
const chats = [
  {
    label: "A group chat where the plan gets lost",
    meta: "312 unread",
    messages: [
      { who: "Maya", tile: "--tile-went-clubbing", text: "wait which weekend did we land on?" },
      { who: "Jonas", tile: "--tile-puked", text: "did anyone actually book the house" },
      { who: "Sara", tile: "--tile-drink", text: "scroll up, it's there somewhere" },
    ],
  },
  {
    label: "A group chat where nobody shares the photos",
    meta: "Three weeks ago",
    messages: [
      { who: "Ali", tile: "--tile-went-home", text: "can someone send the pics??" },
      { who: "Maya", tile: "--tile-went-clubbing", text: "yes!! pls send" },
      { who: "Jonas", tile: "--tile-puked", text: "will do tonight" },
    ],
  },
];

// Use cases: the hero plus the ones that prove it, each with its own page (src/data/events.ts).
const useCases = events;

const faq = [
  {
    q: "How is it different from a group chat and a shared album?",
    a: "A group chat buries the plan, and somebody has to run the album. In After Stories every poll becomes a decision you can see at a glance, everyone's photos land in the same event, and the morning after you get the story without anyone making it.",
  },
  {
    q: "What happens after 48 hours?",
    a: "The event is deleted for everyone: the chat, the polls and the photos. Before that, everyone gets a reminder and can save all the photos to their own phone with one tap.",
  },
  {
    q: "Can friends without an iPhone join?",
    a: "Yes. The invite link works for everyone. Friends without an iPhone join from the web.",
  },
  {
    q: "Who can see what we share?",
    a: "Only the people in the event. There is no public feed, no followers and no discovery. Photos are stripped of location and camera data before they're uploaded.",
  },
  {
    q: "Can we use it for a work event?",
    a: "Yes. Vote on the date, decide the place and share the photos from the team dinner or the summer party, instead of a calendar poll and a dozen emails. And there's no work chat left behind afterwards.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "After Stories",
    operatingSystem: "iOS",
    applicationCategory: "SocialNetworkingApplication",
    description,
    url: "https://after-stories.com/",
    publisher: { "@type": "Organization", name: "12f ApS", url: "https://12f.dk" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <SiteHeader />

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1>
            <span class="line">Plan it together.</span>
            <span class="line">Live it together.</span>
            <span class="line">Wake up to the story.</span>
          </h1>
          <p class="lede">
            One private place for your group's next trip, party or night out. Decide it, live it, and
            get every photo the morning after. Then it disappears.
          </p>
          <div class="cta">
            <span class="pill" aria-disabled="true">Coming soon to the App Store</span>
            <p class="fineprint">For iPhone. Friends without one join from the web.</p>
          </div>
        </div>

        <figure class="summary" aria-label="Example of the morning-after summary for a weekend away">
          <div class="summary-head">
            <span class="sun" aria-hidden="true">☀️</span>
            <div>
              <p class="summary-kicker">The morning after</p>
              <p class="summary-title">Lake house weekend</p>
            </div>
          </div>

          <div class="best-photo" role="img" aria-label="The most-liked photo: the group on the jetty at sunset">
            <span class="best-badge">Photo of the trip <span aria-label="9 likes">❤️ 9</span></span>
          </div>

          <blockquote class="best-line">
            <p>“Who packed the fondue set but no cheese?”</p>
            <footer><span>Jonas</span><span aria-label="7 likes">❤️ 7</span></footer>
          </blockquote>

          <div>
            <p class="mini-label">What you decided</p>
            <ol class="timeline">
              {
                decided.map((d) => (
                  <li>
                    <time>{d.when}</time>
                    <span>{d.what}</span>
                  </li>
                ))
              }
            </ol>
          </div>

          <span class="pill pill-block" aria-hidden="true">Save all 214 photos</span>
          <p class="summary-foot">Disappears in 47 hours</p>
        </figure>
      </div>
    </section>

    <section class="section wrap">
      <h2 class="section-title">The plan got lost in the group chat. The photos never left everyone's phone.</h2>
      <div class="pain-grid">
        {
          chats.map((c) => (
            <figure class="chat" aria-label={c.label}>
              {c.messages.map((m) => (
                <div class="msg">
                  <span class="avatar" style={`--tile:var(${m.tile})`} aria-hidden="true">
                    {m.who[0]}
                  </span>
                  <div>
                    <p class="msg-who">{m.who}</p>
                    <p class="bubble">{m.text}</p>
                  </div>
                </div>
              ))}
              <figcaption class="chat-meta">{c.meta}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section id="how" class="section wrap">
      <h2 class="section-title">One event. From the first idea to the morning after.</h2>
      <ol class="steps">
        {
          beats.map((b) => (
            <li class="step">
              <p class="step-when">{b.when}</p>
              <h3>{b.name}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section wrap ends">
      <p class="ends-number" aria-hidden="true">48h</p>
      <div class="ends-copy">
        <h2 class="section-title">What happens on the trip stays in the trip.</h2>
        <p>
          48 hours after the event ends, it's deleted for everyone. The chat, the polls, the photos.
          Before that, you save every photo to your phone with one tap. You keep the memories. The app
          forgets the rest.
        </p>
      </div>
    </section>

    <section class="section wrap">
      <h2 class="section-title">Anything you plan with more than one person.</h2>
      <ul class="tiles">
        {
          useCases.map((u) => (
            <li>
              <a class="tile tile-link" href={eventHref(u)}>
                <span class="tile-emoji" aria-hidden="true">{u.emoji}</span>
                <span>{u.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section wrap">
      <h2 class="section-title">Only the people in the event. Nobody else.</h2>
      <ul class="facts">
        <li><strong>No feed, no followers, no strangers.</strong> Each event is its own private space.</li>
        <li><strong>Never your location.</strong> Places are venues you pick. Photos are stripped of GPS and camera data before upload.</li>
        <li><strong>Gone 48 hours after.</strong> Nothing lingers on a server for years.</li>
        <li><strong>Sign in with Apple.</strong> No passwords to remember or leak.</li>
      </ul>
    </section>

    <section class="section wrap">
      <h2 class="section-title">Good to know</h2>
      <div class="faq-list">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="closer">
      <div class="wrap closer-inner">
        <h2>Your next plan deserves a better morning after.</h2>
        <span class="pill" aria-disabled="true">Coming soon to the App Store</span>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* The morning-after summary: a quiet mock of the summary screen. */
  .summary {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 28px;
    padding: 24px;
    display: grid;
    gap: 16px;
    box-shadow: 0 30px 80px -30px rgba(255, 45, 111, 0.35);
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }

  .summary-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .sun {
    font-size: 2rem;
  }

  .summary-kicker {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .summary-title {
    font-family: var(--display);
    font-stretch: 85%;
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }

  /* A drawn stand-in for the most-liked photo: a lake at sunset. */
  .best-photo {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 16px;
    background:
      radial-gradient(circle at 70% 58%, #ffd29a 0 7%, transparent 8%),
      linear-gradient(180deg, #ff8a6b 0%, #ff2d6f 38%, #3b1530 58%, #1a2a44 59%, #0e1626 100%);
    overflow: hidden;
  }

  .best-photo::after {
    content: "";
    position: absolute;
    inset: 54% 0 0 0;
    background: repeating-linear-gradient(180deg, rgba(255, 210, 154, 0.18) 0 2px, transparent 2px 9px);
  }

  .best-badge {
    display: inline-flex;
    gap: 8px;
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    background: rgba(11, 12, 14, 0.75);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .best-line {
    margin: 0;
    background: var(--surface-elevated);
    border-radius: 14px;
    padding: 12px 14px;
  }

  .best-line p {
    font-weight: 600;
  }

  .best-line footer {
    display: flex;
    gap: 12px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-top: 4px;
  }

  .mini-label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .timeline li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 0.9375rem;
  }

  .timeline time {
    color: var(--accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    flex: none;
    min-width: 5.5ch;
  }

  .summary-foot {
    text-align: center;
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    margin-top: -6px;
  }

  /* The pain: two group chats that went nowhere. */
  .pain-grid {
    display: grid;
    gap: 16px;
    margin-top: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .chat {
    margin: 0;
    background: var(--surface);
    border-radius: var(--radius-card);
    padding: 20px;
    display: grid;
    gap: 12px;
  }

  .msg {
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--tile);
    color: var(--tile-ink);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .msg-who {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin: 0 0 2px 14px;
  }

  .bubble {
    background: var(--surface-elevated);
    border-radius: 18px 18px 18px 6px;
    padding: 8px 14px;
    font-size: 0.9375rem;
  }

  .chat-meta {
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    text-align: right;
  }

  /* Then it's gone: the number in the headline cut, at poster size. */
  .ends {
    display: grid;
    gap: 16px 56px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .ends {
      grid-template-columns: auto 1fr;
    }
  }

  .ends-number {
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: clamp(5.5rem, 20vw, 11rem);
    line-height: 0.85;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .ends-copy p {
    margin-top: 20px;
    color: var(--text-secondary);
    max-width: 52ch;
    font-size: 1.125rem;
  }
</style>
