---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LaunchCta from "../components/LaunchCta.astro";
import Icon from "../components/Icon.astro";
import LakePhoto from "../components/LakePhoto.astro";
import { events, eventHref } from "../data/events";

// Copy and structure: docs/positioning.md › The landing page.
const title = "After Stories — Plan it together. Live it together. Wake up to the story.";
const description =
  "A private app for one trip, party or night out. Vote on the plan, share photos in one stream, and wake up to the morning-after story. Everything disappears 48 hours after.";

// Hero: the morning-after summary of a weekend away (the hero use case).
const decided = [
  { when: "Fri", what: "Lake house, Hallstatt" },
  { when: "Sat 13:00", what: "Hike to the waterfall" },
  { when: "Sat 20:00", what: "Fondue at Maya's place" },
];

// The three beats (the eight steps, compressed for a first-time visitor).
const beats = [
  {
    key: "plan",
    when: "Before",
    name: "Plan it together",
    text: "Create the event and send the link. Ask which weekend, which house, who drives. Every vote turns into a decision, and the decisions stay on top as a timeline. Nobody scrolls back to find them.",
  },
  {
    key: "live",
    when: "During",
    name: "Live it together",
    text: "One stream for the whole event: “10 minutes late”, the photos, where to go next. Tap ❤️ on the ones that matter.",
  },
  {
    key: "after",
    when: "The morning after",
    name: "Wake up to the story",
    text: "Everyone gets the summary: the most-liked photo, the line of the night, what you decided. Then save every photo to your phone with one tap.",
  },
];

// The pain: two group chats that went nowhere, seen from the visitor's phone: their own message
// on the right (mine), everyone else's on the left. Avatars use the app's tile ramp, like its fallback.
const chats = [
  {
    label: "A group chat where the plan gets lost",
    meta: "312 unread",
    messages: [
      { who: "You", mine: true, text: "wait which weekend did we land on?" },
      { who: "Jonas", tile: "--tile-puked", text: "did anyone actually book the house" },
      { who: "Sara", tile: "--tile-drink", text: "scroll up, it's there somewhere" },
    ],
  },
  {
    label: "A group chat where nobody shares the photos",
    meta: "Three weeks ago",
    messages: [
      { who: "You", mine: true, text: "can someone send the pics??" },
      { who: "Maya", tile: "--tile-went-clubbing", text: "yes!! pls send" },
      { who: "Jonas", tile: "--tile-puked", text: "will do tonight" },
    ],
  },
];

// Use cases: the hero plus the ones that prove it, each with its own page (src/data/events.ts).
const useCases = events;

const faq = [
  {
    q: "How is it different from a group chat and a shared album?",
    a: "A group chat buries the plan, and somebody has to run the album. In After Stories every poll becomes a decision you can see at a glance, everyone's photos land in the same event, and the morning after you get the story without anyone making it.",
  },
  {
    q: "What happens after 48 hours?",
    a: "The event is deleted for everyone: the chat, the polls and the photos. Before that, everyone gets a reminder and can save all the photos to their own phone with one tap.",
  },
  {
    q: "Can friends without an iPhone join?",
    a: "Yes. The invite link works for everyone. Friends without an iPhone join from the web.",
  },
  {
    q: "Who can see what we share?",
    a: "Only the people in the event. There is no public feed, no followers and no discovery. Photos are stripped of location and camera data before they're uploaded.",
  },
  {
    q: "Can we use it for a work event?",
    a: "Yes. Vote on the date, decide the place and share the photos from the team dinner or the summer party, instead of a calendar poll and a dozen emails. And there's no work chat left behind afterwards.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "After Stories",
    operatingSystem: "iOS",
    applicationCategory: "SocialNetworkingApplication",
    description,
    url: "https://after-stories.com/",
    publisher: { "@type": "Organization", name: "12f ApS", url: "https://12f.dk" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <SiteHeader />

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1>
            <span class="line">Plan it together.</span>
            <span class="line">Live it together.</span>
            <span class="line">Wake up to the story.</span>
          </h1>
          <p class="lede">
            The private app for your group's trip, party or night out. Decide the plan together, live it
            in one place, and wake up to everyone's photos. Nobody has to chase anyone.
          </p>
          <div class="cta">
            <LaunchCta as="link" />
            <p class="fineprint">For iPhone. Friends without one join from the web.</p>
          </div>
        </div>

        <figure class="summary" aria-label="Example of the morning-after summary for a weekend away">
          <div class="summary-head">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" />
              <g stroke-width="2" stroke-linecap="round">
                <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
              </g>
            </svg>
            <div>
              <p class="summary-kicker">The morning after</p>
              <p class="summary-title">Lake house weekend</p>
            </div>
          </div>

          <div class="best-photo" role="img" aria-label="The most-liked photo: the group on the jetty at sunset">
            <LakePhoto />
            <span class="best-badge">Photo of the trip <span aria-label="9 likes">❤️ 9</span></span>
          </div>

          <blockquote class="best-line">
            <p>“Who packed the fondue set but no cheese?”</p>
            <footer>
              <span class="who"><span class="avatar" style="--tile:var(--tile-puked)" aria-hidden="true">J</span>Jonas</span>
              <span aria-label="7 likes">❤️ 7</span>
            </footer>
          </blockquote>

          <div>
            <p class="mini-label">What you decided</p>
            <ol class="timeline">
              {
                decided.map((d) => (
                  <li>
                    <time>{d.when}</time>
                    <span>{d.what}</span>
                  </li>
                ))
              }
            </ol>
          </div>

          <span class="pill pill-block" aria-hidden="true">
            <svg class="save-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" />
            </svg>
            Save all 214 photos
          </span>
          <p class="summary-foot">Disappears in 47 hours</p>
        </figure>
      </div>
    </section>

    <section class="section wrap">
      <h2 class="section-title">Group chats are where plans go to die.</h2>
      <p class="section-intro">
        The plan sinks under 400 messages, the photos never leave everyone's phone, and somehow you're the
        one scrolling up, chasing replies and begging for the pictures. Getting your friends together
        shouldn't feel like a second job.
      </p>
      <div class="pain-grid">
        {
          chats.map((c) => (
            <figure class="chat" aria-label={c.label}>
              {c.messages.map((m) =>
                m.mine ? (
                  <div class="msg msg-mine">
                    <p class="bubble">
                      <span class="visually-hidden">You: </span>
                      {m.text}
                    </p>
                  </div>
                ) : (
                  <div class="msg">
                    <span class="avatar" style={`--tile:var(${m.tile})`} aria-hidden="true">
                      {m.who[0]}
                    </span>
                    <div>
                      <p class="msg-who">{m.who}</p>
                      <p class="bubble">{m.text}</p>
                    </div>
                  </div>
                ),
              )}
              <figcaption class="chat-meta">{c.meta}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section id="how" class="section wrap">
      <h2 class="section-title">From “we should do something” to the morning after, in three steps.</h2>
      <p class="section-intro">
        We've all been the one holding the group chat together. After Stories holds it for you, so you
        get to be at the party instead of running it.
      </p>
      <ol class="steps">
        {
          beats.map((b) => (
            <li class="step">
              <p class="step-when">{b.when}</p>
              <h3>{b.name}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="section-cta">
        <LaunchCta as="link" />
      </div>
    </section>

    <section class="section wrap ends">
      <p class="ends-number" aria-hidden="true">48h</p>
      <div class="ends-copy">
        <h2 class="section-title">What happens on the trip stays in the trip.</h2>
        <p>
          48 hours after the event ends, it's deleted for everyone. The chat, the polls, the photos.
          Before that, you save every photo to your phone with one tap. You keep the memories. The app
          forgets the rest.
        </p>
      </div>
    </section>

    <section class="section wrap">
      <h2 class="section-title">Anything you plan with more than one person.</h2>
      <ul class="tiles">
        {
          useCases.map((u) => (
            <li>
              <a class="tile tile-link" href={eventHref(u)}>
                <Icon class="tile-icon" name={u.icon} />
                <span>{u.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section wrap">
      <h2 class="section-title">Only the people in the event. That's a promise.</h2>
      <ul class="facts">
        <li><strong>No feed, no followers, no strangers.</strong> Each event is its own private space.</li>
        <li><strong>Never your location.</strong> Places are venues you pick. Photos are stripped of GPS and camera data before upload.</li>
        <li><strong>Gone 48 hours after.</strong> Everyone saves the photos first. Then nothing lingers on a server for years.</li>
        <li><strong>Nobody left out.</strong> Friends without an iPhone join from the web. Sign in with Apple means no passwords.</li>
      </ul>
    </section>

    <section class="section wrap">
      <h2 class="section-title">Good to know</h2>
      <div class="faq-list">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="closer">
      <div class="wrap closer-inner">
        <h2>Wake up to the whole story.</h2>
        <div class="closer-story">
          <p>
            The morning after, it's all there: the photo everyone loved, the line everyone's still quoting,
            what you decided, and every picture already on your phone. Nobody had to make it.
          </p>
          <p class="closer-stakes">Or plan the next one in the group chat, and wait three weeks for photos that never come.</p>
        </div>
        <LaunchCta as="form" />
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* The morning-after summary: a mock of the summary screen. */
  .summary {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 32px;
    padding: 20px;
    display: grid;
    gap: 18px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 40px 90px -40px rgba(255, 45, 111, 0.45);
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }

  .summary-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 4px 0;
  }

  .sun {
    flex: none;
    width: 34px;
    height: 34px;
    fill: var(--pending, #ffb340);
    stroke: var(--pending, #ffb340);
  }

  .summary-kicker {
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .summary-title {
    font-family: var(--display);
    font-stretch: 85%;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.05;
  }

  .best-photo {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: 20px;
    overflow: hidden;
    background: #2b1446;
  }

  .best-badge {
    position: absolute;
    left: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(11, 12, 14, 0.55);
    -webkit-backdrop-filter: blur(10px) saturate(1.4);
    backdrop-filter: blur(10px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--badge-ink);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .best-line {
    margin: 0;
    background: var(--surface-elevated);
    border-radius: 18px 18px 18px 6px;
    padding: 14px 16px;
  }

  .best-line p {
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .best-line footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-top: 10px;
  }

  .who {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .mini-label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
    margin: 0 4px 8px;
  }

  /* Time and decision in two columns, so every row lines up. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 4px;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 16px;
    font-size: 0.9375rem;
  }

  .timeline li {
    display: contents;
  }

  .timeline time {
    color: var(--accent-ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .save-icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .summary-foot {
    text-align: center;
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    margin-top: -8px;
  }

  /* The pain: two group chats that went nowhere. */
  .pain-grid {
    display: grid;
    gap: 16px;
    margin-top: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .chat {
    margin: 0;
    background: var(--surface);
    border-radius: var(--radius-card);
    padding: 20px;
    display: grid;
    gap: 12px;
  }

  .msg {
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--tile);
    color: var(--tile-ink);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .msg-who {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin: 0 0 2px 14px;
  }

  .bubble {
    background: var(--surface-elevated);
    border-radius: 18px 18px 18px 6px;
    padding: 8px 14px;
    font-size: 0.9375rem;
  }

  /* Your own message: right-aligned in your bubble colour, tail on the right, no name or avatar. */
  .msg-mine {
    justify-content: flex-end;
  }

  .msg-mine .bubble {
    background: var(--bubble-mine);
    border-radius: 18px 18px 6px 18px;
  }

  .chat-meta {
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    text-align: right;
  }

  /* Then it's gone: the number in the headline cut, at poster size. */
  .ends {
    display: grid;
    gap: 16px 56px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .ends {
      grid-template-columns: auto 1fr;
    }
  }

  .ends-number {
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: clamp(5.5rem, 20vw, 11rem);
    line-height: 0.85;
    letter-spacing: -0.01em;
    color: var(--accent-ink);
  }

  .ends-copy p {
    margin-top: 20px;
    color: var(--text-secondary);
    max-width: 52ch;
    font-size: 1.125rem;
  }
</style>
