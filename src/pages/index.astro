---
import Base from "../layouts/Base.astro";

// Copy and structure: docs/positioning.md › The landing page.
const title = "After Stories — Plan it together. Live it together. Wake up to the story.";
const description =
  "A private app for one trip, party or night out. Vote on the plan, share photos in one stream, and wake up to the morning-after story. Everything disappears 48 hours after.";

// Hero: the morning-after summary of a weekend away (the hero use case).
const decided = [
  { when: "Fri", what: "Lake house, Hallstatt" },
  { when: "Sat 13:00", what: "Hike to the waterfall" },
  { when: "Sat 20:00", what: "Fondue at Maya's place" },
];

// The three beats (the eight steps, compressed for a first-time visitor).
const beats = [
  {
    key: "plan",
    eyebrow: "Before",
    name: "Plan it together",
    text: "Ask the group. Which weekend, which house, who drives. Every vote turns into a decision, and the decisions stay on top as a timeline. Nobody scrolls back to find them.",
  },
  {
    key: "live",
    eyebrow: "During",
    name: "Live it together",
    text: "One stream for the whole event: “10 minutes late”, the photos, where to go next. Tap ❤️ on the ones that matter.",
  },
  {
    key: "after",
    eyebrow: "The morning after",
    name: "Wake up to the story",
    text: "Everyone gets the summary: the most-liked photo, the line of the night, what you decided. Then save every photo to your phone with one tap.",
  },
];

// Use cases: the hero plus the ones that prove it (docs/positioning.md › The use cases).
const useCases = [
  { emoji: "🏔️", name: "Weekend away" },
  { emoji: "🌙", name: "Night out" },
  { emoji: "🎂", name: "Birthday" },
  { emoji: "💍", name: "Bachelor & bachelorette" },
  { emoji: "🎪", name: "Festival" },
  { emoji: "🍝", name: "Dinner night" },
  { emoji: "🥂", name: "Office party" },
];

const faq = [
  {
    q: "How is it different from a group chat and a shared album?",
    a: "A group chat buries the plan, and somebody has to run the album. In After Stories every poll becomes a decision you can see at a glance, everyone's photos land in the same event, and the morning after you get the story without anyone making it.",
  },
  {
    q: "What happens after 48 hours?",
    a: "The event is deleted for everyone: the chat, the polls and the photos. Before that, everyone gets a reminder and can save all the photos to their own phone with one tap.",
  },
  {
    q: "Can friends without an iPhone join?",
    a: "Yes. The invite link works for everyone. Friends without an iPhone join from the web.",
  },
  {
    q: "Who can see what we share?",
    a: "Only the people in the event. There is no public feed, no followers and no discovery. Photos are stripped of location and camera data before they're uploaded.",
  },
  {
    q: "Can we use it for a work event?",
    a: "Yes. Vote on the date, decide the place and share the photos from the team dinner or the summer party, instead of a calendar poll and a dozen emails. And there's no work chat left behind afterwards.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "After Stories",
    operatingSystem: "iOS",
    applicationCategory: "SocialNetworkingApplication",
    description,
    url: "https://after-stories.com/",
    publisher: { "@type": "Organization", name: "12f ApS", url: "https://12f.dk" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <header class="topbar wrap">
    <a class="brand" href="/" aria-label="After Stories home">
      <img src="/apple-touch-icon.png" alt="" width="36" height="36" />
      <span>After Stories</span>
    </a>
    <a class="topbar-link" href="#how">How it works</a>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">For trips, parties and nights out</p>
          <h1>Plan it together.<br />Live it together.<br /><span class="accent">Wake up to the story.</span></h1>
          <p class="lede">
            One private place for your group's next plan. Decide it, live it, and get every photo the
            morning after. Then it disappears.
          </p>
          <div class="cta-row">
            <span class="pill" aria-disabled="true">Coming soon to the App Store</span>
          </div>
          <p class="fineprint">For iPhone. Friends without one join from the web.</p>
        </div>

        <figure class="summary" aria-label="Example of the morning-after summary for a weekend away">
          <div class="summary-head">
            <span class="sun" aria-hidden="true">☀️</span>
            <div>
              <p class="summary-kicker">The morning after</p>
              <p class="summary-title">Lake house weekend</p>
            </div>
          </div>

          <div class="best-photo" role="img" aria-label="The most-liked photo: the group on the jetty at sunset">
            <span class="best-badge">❤️ 9 · Photo of the trip</span>
          </div>

          <blockquote class="best-line">
            <p>“Who packed the fondue set but no cheese?”</p>
            <footer>Jonas · ❤️ 7</footer>
          </blockquote>

          <div>
            <p class="mini-label">What you decided</p>
            <ol class="timeline">
              {
                decided.map((d) => (
                  <li>
                    <time>{d.when}</time>
                    <span>{d.what}</span>
                  </li>
                ))
              }
            </ol>
          </div>

          <span class="pill pill-block" aria-hidden="true">Save all 214 photos</span>
          <p class="summary-foot">Disappears in 47 hours</p>
        </figure>
      </div>
    </section>

    <section class="pain wrap">
      <p class="eyebrow">Sound familiar?</p>
      <h2>The plan got lost in the group chat. The photos never left everyone's phone.</h2>
      <div class="pain-grid">
        <figure class="chat" aria-label="A group chat where the plan gets lost">
          <p class="bubble">wait which weekend did we land on?</p>
          <p class="bubble">did anyone actually book the house</p>
          <p class="bubble">scroll up, it's there somewhere</p>
          <p class="chat-meta">312 unread</p>
        </figure>
        <figure class="chat" aria-label="A group chat where nobody shares the photos">
          <p class="bubble">can someone send the pics??</p>
          <p class="bubble">yes!! pls send</p>
          <p class="bubble">will do tonight</p>
          <p class="chat-meta">Three weeks ago</p>
        </figure>
      </div>
    </section>

    <section id="how" class="how wrap">
      <p class="eyebrow">How it works</p>
      <h2>One event. From the first idea to the morning after.</h2>
      <ol class="beats">
        {
          beats.map((b, i) => (
            <li class={`beat beat-${b.key}`}>
              <span class="beat-num">{String(i + 1).padStart(2, "0")}</span>
              <p class="eyebrow">{b.eyebrow}</p>
              <h3>{b.name}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="ends wrap">
      <div class="ends-number" aria-hidden="true">48h</div>
      <div class="ends-copy">
        <p class="eyebrow">Then it's gone</p>
        <h2>What happens on the trip stays in the trip.</h2>
        <p>
          48 hours after the event ends, it's deleted for everyone. The chat, the polls, the photos.
          Before that, you save every photo to your phone with one tap. You keep the memories. The app
          forgets the rest.
        </p>
      </div>
    </section>

    <section class="uses wrap">
      <p class="eyebrow">Works for</p>
      <h2>Anything you plan with more than one person.</h2>
      <ul class="chips">
        {
          useCases.map((u) => (
            <li class="chip">
              <span aria-hidden="true">{u.emoji}</span>
              {u.name}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="privacy wrap">
      <p class="eyebrow">Private by design</p>
      <h2>Only the people in the event. Nobody else.</h2>
      <ul class="privacy-list">
        <li><strong>No feed, no followers, no strangers.</strong> Each event is its own private space.</li>
        <li><strong>Never your location.</strong> Places are venues you pick. Photos are stripped of GPS and camera data before upload.</li>
        <li><strong>Gone 48 hours after.</strong> Nothing lingers on a server for years.</li>
        <li><strong>Sign in with Apple.</strong> No passwords to remember or leak.</li>
      </ul>
    </section>

    <section class="faq wrap">
      <p class="eyebrow">Questions</p>
      <h2>Good to know</h2>
      <div class="faq-list">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="closer wrap">
      <h2>Your next plan deserves a better morning after.</h2>
      <span class="pill" aria-disabled="true">Coming soon to the App Store</span>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <p class="eyebrow">Plan it. Live it. Wake up to the story.</p>
      <p class="footer-meta">© {new Date().getFullYear()} <a href="https://12f.dk">12f ApS</a></p>
    </div>
  </footer>
</Base>

<style>
  .accent {
    color: var(--accent);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .brand img {
    border-radius: 9px;
  }

  .topbar-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .topbar-link:hover {
    color: var(--text-primary);
  }

  /* Hero — the background fades from night into the icon's dawn tint. */
  .hero {
    background: linear-gradient(180deg, var(--background) 0%, var(--dawn) 100%);
    padding: 40px 0 72px;
  }

  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.15fr 1fr;
    }
    .hero {
      padding: 72px 0 112px;
    }
  }

  .hero-copy {
    display: grid;
    gap: 20px;
  }

  h1 {
    font-size: clamp(2.375rem, 6.5vw, 4rem);
    font-weight: 800;
  }

  .lede {
    font-size: 1.1875rem;
    color: var(--text-secondary);
    max-width: 36ch;
  }

  .cta-row {
    margin-top: 8px;
  }

  .fineprint {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  /* The morning-after summary: a quiet mock of the summary screen. */
  .summary {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 28px;
    padding: 24px;
    display: grid;
    gap: 16px;
    box-shadow: 0 30px 80px -30px rgba(255, 45, 111, 0.35);
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }

  .summary-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .sun {
    font-size: 2rem;
  }

  .summary-kicker {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .summary-title {
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }

  /* A drawn stand-in for the most-liked photo: a lake at sunset. */
  .best-photo {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 16px;
    background:
      radial-gradient(circle at 70% 58%, #ffd29a 0 7%, transparent 8%),
      linear-gradient(180deg, #ff8a6b 0%, #ff2d6f 38%, #3b1530 58%, #1a2a44 59%, #0e1626 100%);
    overflow: hidden;
  }

  .best-photo::after {
    content: "";
    position: absolute;
    inset: 54% 0 0 0;
    background: repeating-linear-gradient(180deg, rgba(255, 210, 154, 0.18) 0 2px, transparent 2px 9px);
  }

  .best-badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    background: rgba(11, 12, 14, 0.75);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .best-line {
    margin: 0;
    background: var(--surface-elevated);
    border-radius: 14px;
    padding: 12px 14px;
  }

  .best-line p {
    font-weight: 600;
  }

  .best-line footer {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-top: 4px;
  }

  .mini-label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .timeline li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 0.9375rem;
  }

  .timeline time {
    color: var(--accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    flex: none;
    min-width: 5.5ch;
  }

  .pill-block {
    justify-content: center;
    width: 100%;
  }

  .summary-foot {
    text-align: center;
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    margin-top: -6px;
  }

  /* Sections */
  section:not(.hero) {
    padding-top: 88px;
  }

  section h2 {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 800;
    margin: 12px 0 16px;
    max-width: 24ch;
  }

  /* The pain: two group chats that went nowhere. */
  .pain-grid {
    display: grid;
    gap: 16px;
    margin-top: 32px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .chat {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    padding: 20px;
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  .bubble {
    background: var(--surface-elevated);
    border-radius: 18px 18px 18px 6px;
    padding: 8px 14px;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .chat-meta {
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    margin-top: 4px;
  }

  /* How it works */
  .beats {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .beat {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    padding: 24px;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .beat-after {
    border-color: var(--accent);
  }

  .beat-num {
    position: absolute;
    top: 20px;
    right: 22px;
    color: var(--text-tertiary);
    font-weight: 700;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .beat h3 {
    font-size: 1.375rem;
  }

  .beat p:not(.eyebrow) {
    color: var(--text-secondary);
  }

  /* Then it's gone */
  .ends {
    display: grid;
    gap: 16px 48px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .ends {
      grid-template-columns: auto 1fr;
    }
  }

  .ends-number {
    font-size: clamp(5rem, 18vw, 10rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
  }

  .ends-copy p:not(.eyebrow) {
    color: var(--text-secondary);
    max-width: 58ch;
    font-size: 1.125rem;
  }

  /* Works for */
  .chips {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    font-weight: 600;
  }

  .chip:first-child {
    border-color: var(--accent);
  }

  /* Privacy */
  .privacy-list {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    gap: 12px;
    max-width: 720px;
  }

  .privacy-list li {
    background: var(--surface);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 16px 20px;
    color: var(--text-secondary);
  }

  .privacy-list strong {
    color: var(--text-primary);
  }

  /* FAQ */
  .faq-list {
    margin-top: 28px;
    display: grid;
    gap: 10px;
    max-width: 760px;
  }

  details {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 0 20px;
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    padding: 16px 0;
    min-height: 44px;
  }

  details p {
    color: var(--text-secondary);
    padding-bottom: 18px;
  }

  /* Closer */
  .closer {
    display: grid;
    justify-items: start;
    gap: 8px;
  }

  .footer {
    margin-top: 112px;
    border-top: 1px solid var(--hairline);
    padding: 32px 0 48px;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
  }

  .footer-meta {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .footer-meta a {
    color: var(--text-secondary);
  }
</style>
